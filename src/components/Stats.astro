---
/**
 * Chiffres clés. Deux variantes :
 * - "dark" (défaut) : bande sombre compacte (pages intérieures)
 * - "light" : grand moment typographique sur fond blanc (accueil)
 * Les valeurs s'affichent d'emblée à leur valeur réelle : pas de comptage
 * animé, pour qu'aucun visiteur (ni capture d'écran) ne lise jamais un
 * chiffre intermédiaire faux (ex. « 15 ans » au lieu de 20).
 */
import { stats as defaultStats } from "../data/site";
export interface Props {
  items?: { value: string; label: string }[];
  variant?: "dark" | "light";
}
const { items = defaultStats, variant = "dark" } = Astro.props;
---

<section class:list={["section--tight stats", variant === "dark" ? "bg-navy" : "stats--light"]}>
  <div class="container">
    <ul class="stats-grid">
      {
        items.map((s) => (
          <li class="stat reveal">
            <span class="stat-value">{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .stats-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.5rem clamp(1rem, 3vw, 2rem);
    border-left: 1px solid rgba(255, 255, 255, 0.15);
  }
  .stat:first-child { border-left: none; }
  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    font-weight: 800;
    color: var(--color-blanc);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-laiton-clair);
  }

  /* Variante claire : chiffres géants encre sur blanc (accueil) */
  .stats--light { background: var(--color-blanc); border-block: 1px solid var(--color-border); padding-block: clamp(3.5rem, 7vw, 5.5rem); }
  .stats--light .stat { border-left-color: var(--color-border); }
  .stats--light .stat-value { color: var(--color-encre); font-size: clamp(2.4rem, 4.6vw, 3.9rem); white-space: nowrap; }
  .stats--light .stat-label { color: var(--color-laiton-fonce); }

  @media (max-width: 680px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 2rem 0; }
    .stat:nth-child(3) { border-left: none; }
  }
</style>

