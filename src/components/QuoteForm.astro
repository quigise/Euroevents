---
/**
 * Formulaire de devis — contenu repris à l'identique de l'ancien site
 * (types, lieux recherchés, prestataires, animations, repérage…),
 * présenté dans le parcours en 5 étapes du nouveau design.
 */
import { WEB3FORMS_KEY, contact } from "../data/site";

const typesEvenement = [
  { label: "Séminaire / Congrès", icon: "🏛️" },
  { label: "Journée de travail", icon: "📊" },
  { label: "Soirée professionnelle", icon: "✨" },
  { label: "Fête de fin d'année", icon: "🎉" },
  { label: "Hébergement", icon: "🛏️" },
];
const lieuxRecherches = [
  "Salle de réunion", "Amphithéâtre", "Hôtel", "Péniche", "Domaine / Château", "Lieu évènementiel",
];
const prestataires = ["Traiteur", "Décorateur", "Location matériel technique"];
const animations = ["Animateur", "Orchestre / DJ", "Magicien", "Spectacle musical", "PhotoBooth / Magnets"];
---

<form class="ee-form quote-form" id="quote-form" novalidate>
  <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
  <input
    type="hidden"
    name="subject"
    value="Nouvelle demande de devis — configurateur Euro Events"
  />
  <input type="hidden" name="from_name" value="Site Euro Events — Devis" />
  <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />

  <!-- Barre de progression -->
  <div class="stepper" aria-hidden="true">
    <div class="stepper-bar"><span class="stepper-fill" id="stepper-fill"></span></div>
    <div class="stepper-labels">
      <span class="active">Événement</span>
      <span>Date & lieu</span>
      <span>Lieu recherché</span>
      <span>Prestations</span>
      <span>Coordonnées</span>
    </div>
  </div>

  <!-- Étape 1 — Type d'événement -->
  <fieldset class="step is-active" data-step="1">
    <legend><span class="step-kicker">Étape 1/5</span> Type d'événement</legend>
    <p class="step-hint">Plusieurs choix possibles.</p>
    <div class="option-grid">
      {
        typesEvenement.map((t) => (
          <label class="option-card">
            <input type="checkbox" name="type_evenement" value={t.label} />
            <span class="option-icon">{t.icon}</span>
            <span class="option-label">{t.label}</span>
          </label>
        ))
      }
    </div>
    <div class="field-group">
      <p class="field-group-label">L'évènement doit avoir lieu :</p>
      <div class="option-grid option-grid--compact option-grid--inline">
        <label class="option-card option-card--sm">
          <input type="checkbox" name="moment_evenement" value="En journée" />
          <span class="option-label">En journée</span>
        </label>
        <label class="option-card option-card--sm">
          <input type="checkbox" name="moment_evenement" value="En soirée" />
          <span class="option-label">En soirée</span>
        </label>
      </div>
    </div>
    <div class="step-actions">
      <span></span>
      <button type="button" class="btn btn--primary" data-next>Continuer</button>
    </div>
  </fieldset>

  <!-- Étape 2 — Date, localisation, participants -->
  <fieldset class="step" data-step="2" hidden>
    <legend><span class="step-kicker">Étape 2/5</span> Date & lieu</legend>
    <div class="field-row">
      <div class="field">
        <label for="q-date">Date</label>
        <input id="q-date" name="date" type="date" />
      </div>
      <div class="field">
        <label for="q-personnes">Nombre de personnes</label>
        <input id="q-personnes" name="nombre_personnes" type="text" inputmode="numeric" placeholder="Ex. 80" />
      </div>
    </div>
    <div class="field">
      <label for="q-localisation">Localisation (Pays / Région / Ville)</label>
      <input id="q-localisation" name="localisation" type="text" placeholder="Ex. France, Normandie, Deauville…" />
    </div>
    <div class="step-actions">
      <button type="button" class="btn btn--ghost" data-prev>← Retour</button>
      <button type="button" class="btn btn--primary" data-next>Continuer</button>
    </div>
  </fieldset>

  <!-- Étape 3 — Lieu recherché -->
  <fieldset class="step" data-step="3" hidden>
    <legend><span class="step-kicker">Étape 3/5</span> Lieu recherché</legend>
    <p class="step-hint">Plusieurs choix possibles.</p>
    <div class="option-grid option-grid--compact">
      {
        lieuxRecherches.map((l) => (
          <label class="option-card option-card--sm">
            <input type="checkbox" name="lieu_recherche" value={l} />
            <span class="option-label">{l}</span>
          </label>
        ))
      }
    </div>
    <div class="step-actions">
      <button type="button" class="btn btn--ghost" data-prev>← Retour</button>
      <button type="button" class="btn btn--primary" data-next>Continuer</button>
    </div>
  </fieldset>

  <!-- Étape 4 — Prestataires, animations, recherche & budget -->
  <fieldset class="step" data-step="4" hidden>
    <legend><span class="step-kicker">Étape 4/5</span> Prestataires & animations</legend>
    <div class="field-group">
      <p class="field-group-label">Prestataires</p>
      <div class="option-grid option-grid--compact">
        {
          prestataires.map((p) => (
            <label class="option-card option-card--sm">
              <input type="checkbox" name="prestataires" value={p} />
              <span class="option-label">{p}</span>
            </label>
          ))
        }
      </div>
    </div>
    <div class="field-group">
      <p class="field-group-label">Animations</p>
      <div class="option-grid option-grid--compact">
        {
          animations.map((a) => (
            <label class="option-card option-card--sm">
              <input type="checkbox" name="animations" value={a} />
              <span class="option-label">{a}</span>
            </label>
          ))
        }
      </div>
    </div>
    <div class="field">
      <label for="q-nature">Précisez la nature de votre recherche</label>
      <textarea id="q-nature" name="nature_recherche" rows="3" placeholder="Objectifs, contraintes, idées…"></textarea>
    </div>
    <div class="field">
      <label for="q-budget">Budget maximum</label>
      <input id="q-budget" name="budget_maximum" type="text" inputmode="numeric" />
    </div>
    <div class="step-actions">
      <button type="button" class="btn btn--ghost" data-prev>← Retour</button>
      <button type="button" class="btn btn--primary" data-next>Continuer</button>
    </div>
  </fieldset>

  <!-- Étape 5 — Coordonnées -->
  <fieldset class="step" data-step="5" hidden>
    <legend><span class="step-kicker">Étape 5/5</span> Vos coordonnées</legend>
    <p class="step-hint">Notre experte vous recontacte sous 24-48 h avec une première sélection.</p>
    <div class="field-row">
      <div class="field">
        <label for="q-nom">Nom <span aria-hidden="true">*</span></label>
        <input id="q-nom" name="nom" type="text" required autocomplete="family-name" />
      </div>
      <div class="field">
        <label for="q-prenom">Prénom <span aria-hidden="true">*</span></label>
        <input id="q-prenom" name="prenom" type="text" required autocomplete="given-name" />
      </div>
    </div>
    <div class="field-row">
      <div class="field">
        <label for="q-societe">Société</label>
        <input id="q-societe" name="societe" type="text" autocomplete="organization" />
      </div>
      <div class="field">
        <label for="q-fonction">Fonction</label>
        <input id="q-fonction" name="fonction" type="text" autocomplete="organization-title" />
      </div>
    </div>
    <div class="field">
      <label for="q-adresse">Adresse</label>
      <input id="q-adresse" name="adresse" type="text" autocomplete="street-address" />
    </div>
    <div class="field-row">
      <div class="field">
        <label for="q-email">Email <span aria-hidden="true">*</span></label>
        <input id="q-email" name="email" type="email" required autocomplete="email" />
      </div>
      <div class="field">
        <label for="q-phone">Téléphone <span aria-hidden="true">*</span></label>
        <input id="q-phone" name="telephone" type="tel" required autocomplete="tel" />
      </div>
    </div>
    <label class="consent">
      <input type="checkbox" name="visites_reperage" value="Oui" />
      <span>
        Je souhaite que l'agence m'organise des visites de repérage sur des sites ou des
        rencontres avec des prestataires pour organiser mon événement.
      </span>
    </label>
    <label class="consent">
      <input type="checkbox" required />
      <span>
        J'accepte d'être recontacté(e) au sujet de ma demande.
        Voir la <a href="/politique-confidentialite/">politique de confidentialité</a>.
      </span>
    </label>
    <div class="step-actions">
      <button type="button" class="btn btn--ghost" data-prev>← Retour</button>
      <button type="submit" class="btn btn--primary btn--lg">Envoyer ma demande</button>
    </div>
  </fieldset>

  <p class="form-status" role="status" aria-live="polite"></p>
  <p class="form-alt">
    Vous préférez en parler de vive voix ?
    <a href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a>
    — {contact.hours.toLowerCase()}.
  </p>
</form>

<script>
  import { submitWeb3Form } from "../scripts/forms";

  const form = document.getElementById("quote-form") as HTMLFormElement | null;
  if (form) {
    // Pré-sélection via paramètre d'URL (?type=…) depuis les pages événements,
    // rapportée aux catégories du formulaire (reprises de l'ancien site).
    const params = new URLSearchParams(window.location.search);
    const typeSlug = params.get("type");
    if (typeSlug) {
      const map: Record<string, string> = {
        "seminaires-entreprise": "Séminaire / Congrès",
        conventions: "Séminaire / Congrès",
        "soirees-entreprise": "Soirée professionnelle",
        "team-building": "Journée de travail",
        "reunions-journees-etude": "Journée de travail",
      };
      const wanted = map[typeSlug];
      if (wanted) {
        const box = form.querySelector<HTMLInputElement>(
          `input[name="type_evenement"][value="${wanted}"]`
        );
        if (box) box.checked = true;
      }
    }

    const steps = Array.from(form.querySelectorAll<HTMLElement>(".step"));
    const fill = form.querySelector<HTMLElement>("#stepper-fill");
    const labels = Array.from(form.querySelectorAll<HTMLElement>(".stepper-labels span"));
    let index = steps.findIndex((s) => s.classList.contains("is-active"));
    if (index < 0) index = 0;

    function render() {
      steps.forEach((s, i) => {
        const active = i === index;
        s.classList.toggle("is-active", active);
        s.hidden = !active;
      });
      labels.forEach((l, i) => l.classList.toggle("active", i <= index));
      if (fill) fill.style.width = `${((index + 1) / steps.length) * 100}%`;
      // Focus sur la légende pour l'accessibilité
      const legend = steps[index].querySelector("legend");
      legend?.setAttribute("tabindex", "-1");
      (legend as HTMLElement | null)?.focus?.();
    }

    // Valide les champs requis de l'étape courante uniquement
    function validateStep(stepEl: HTMLElement): boolean {
      const fields = Array.from(
        stepEl.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
          "input, select, textarea"
        )
      );
      for (const f of fields) {
        if (!f.checkValidity()) {
          f.reportValidity();
          return false;
        }
      }
      return true;
    }

    form.querySelectorAll<HTMLButtonElement>("[data-next]").forEach((btn) =>
      btn.addEventListener("click", () => {
        if (!validateStep(steps[index])) return;
        if (index < steps.length - 1) {
          index++;
          render();
        }
      })
    );
    form.querySelectorAll<HTMLButtonElement>("[data-prev]").forEach((btn) =>
      btn.addEventListener("click", () => {
        if (index > 0) {
          index--;
          render();
        }
      })
    );

    submitWeb3Form(form);
    render();
  }
</script>

<style>
  .quote-form {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: clamp(1.4rem, 3vw, 2.4rem);
  }
  .stepper {
    margin-bottom: 1.8rem;
  }
  .stepper-bar {
    height: 6px;
    background: var(--color-cream);
    border-radius: 999px;
    overflow: hidden;
  }
  .stepper-fill {
    display: block;
    height: 100%;
    width: 20%;
    background: linear-gradient(90deg, var(--color-accent), var(--color-amber-400));
    border-radius: 999px;
    transition: width 0.4s var(--ease);
  }
  .stepper-labels {
    display: flex;
    justify-content: space-between;
    margin-top: 0.6rem;
    gap: 0.3rem;
  }
  .stepper-labels span {
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-muted);
    text-align: center;
    flex: 1;
    transition: color 0.3s var(--ease);
  }
  .stepper-labels span.active {
    color: var(--color-accent-dark);
  }

  .step {
    border: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
  }
  .step[hidden] {
    display: none;
  }
  .step legend {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.5vw, 1.7rem);
    font-weight: 600;
    color: var(--color-primary-dark);
    line-height: 1.2;
    padding: 0;
    outline: none;
  }
  .step-kicker {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-dark);
    margin-bottom: 0.4rem;
  }
  .step-hint {
    margin: -0.4rem 0 0;
    color: var(--color-ink-soft);
    font-size: 0.96rem;
  }
  .field-group { display: grid; gap: 0.6rem; }
  .field-group-label {
    margin: 0;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-primary-dark);
  }
  /* Petits groupes (En journée / En soirée) : cartes à largeur naturelle */
  .option-grid--inline {
    grid-template-columns: repeat(auto-fit, minmax(120px, max-content));
  }
  .option-grid--inline .option-card--sm { padding-inline: 1.6rem; }

  .option-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.8rem;
  }
  .option-grid--compact {
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
  }
  .option-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-align: center;
    padding: 1.2rem 0.8rem;
    background: var(--color-ivory);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    font-weight: 600;
    color: var(--color-primary-dark);
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease),
      transform 0.2s var(--ease);
  }
  .option-card--sm {
    padding: 1rem 0.8rem;
  }
  .option-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-amber-400);
  }
  .option-card input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .option-card:has(input:checked) {
    border-color: var(--color-accent);
    background: var(--color-amber-200);
  }
  .option-card:has(input:focus-visible) {
    outline: 3px solid var(--color-amber-400);
    outline-offset: 2px;
  }
  .option-icon {
    font-size: 1.8rem;
  }
  .option-label {
    font-size: 0.95rem;
  }

  .step-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  @media (max-width: 560px) {
    .stepper-labels span {
      font-size: 0;
    }
    .stepper-labels span.active {
      font-size: 0.74rem;
    }
  }
</style>
