---
export interface Props {
  title?: string;
  eyebrow?: string;
}
const {
  title = "Une expertise qui fait gagner du temps et maîtrise le budget.",
  eyebrow = "Pourquoi nous",
} = Astro.props;

const benefits = [
  ["Sans honoraires de recherche", "Notre rémunération vient des prestataires sélectionnés, sans frais de sourcing pour votre entreprise."],
  ["Des conditions préférentielles", "Vous bénéficiez des tarifs et avantages négociés par Euro Events auprès de son réseau."],
  ["Une experte dédiée", "La même interlocutrice analyse votre besoin, affine la sélection et suit votre projet."],
  ["Une réponse sous 24-48 h", "Vous recevez rapidement des propositions argumentées et adaptées à vos priorités."],
  ["Des partenaires éprouvés", "Un réseau développé depuis 2006, mobilisé selon les exigences de chaque événement."],
  ["Un vrai gain de temps", "Recherche, comparaison et négociation sont prises en charge pour vous permettre de décider sereinement."],
];
---

<section class="section bg-white">
  <div class="container">
    <div class="benefits-head">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
    </div>
    <dl class="benefits-list">
      {
        benefits.map((b, i) => (
          <div class="benefit reveal">
            <dt><span class="benefit-num">{String(i + 1).padStart(2, "0")}</span>{b[0]}</dt>
            <dd>{b[1]}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .benefits-head { max-width: 640px; margin-bottom: clamp(2.2rem, 4vw, 3.2rem); }
  .benefits-list {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 clamp(2rem, 5vw, 4rem);
  }
  .benefit { padding: 1.7rem 0; border-top: 1px solid var(--color-border); }
  .benefit dt {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-encre);
    margin-bottom: 0.5rem;
  }
  .benefit-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: var(--color-laiton-fonce);
  }
  .benefit dd { margin: 0 0 0 2.8rem; color: var(--color-ink-soft); }
  @media (max-width: 760px) {
    .benefits-list { grid-template-columns: 1fr; }
    .benefit dd { margin-left: 0; }
  }
</style>
