---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import LogoCloud from "../components/LogoCloud.astro";
import Testimonials from "../components/Testimonials.astro";
import CTASection from "../components/CTASection.astro";
import { site } from "../data/site";

const title = "Références clients & séminaires d'entreprise | Euro Events";
const description =
  "Références réelles d'Euro Events : séminaires, conventions, réunions, hébergements et soirées organisés depuis 2006 pour La Banque Postale, La Poste, SNCF, Orange, Ermewa et d'autres entreprises.";

const references = [
  {
    name: "La Banque Postale",
    period: "2010–2026",
    participants: "3 à 1 000 participants",
    detail: "Plusieurs centaines de dossiers : séminaires résidentiels, journées d'étude, conventions, hébergement de groupes, team building, traiteurs, hôtesses, soirées, transferts et animations.",
  },
  {
    name: "Groupe La Poste",
    period: "2007–2025",
    participants: "6 à 1 200 participants",
    detail: "Plus de 90 dossiers : séminaires, réunions, conventions, hébergement, restauration, animations et événements internes en France et en Europe.",
  },
  {
    name: "Ermewa",
    period: "2019–2026",
    participants: "7 à 140 participants",
    detail: "Une quinzaine de dossiers : séminaires résidentiels, journées d'étude, hébergement, dîners, soirées, animations et transport.",
  },
  {
    name: "SNCF",
    period: "2010–2025",
    participants: "Groupes jusqu'à environ 110 participants",
    detail: "Séminaires en France et à l'étranger, hébergement, réunions et restauration.",
  },
  {
    name: "Orange",
    period: "2010–2025",
    participants: "21 à 150 participants",
    detail: "Huit dossiers : hébergement de groupes, soirées, séminaires et accompagnement événementiel.",
  },
  {
    name: "Groupe Rocher",
    period: "2013–2025",
    participants: "9 à 600 participants",
    detail: "Une quinzaine de dossiers : réunions, journées d'étude, séminaires résidentiels, hébergement, restauration et animations.",
  },
];

const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Références clients Euro Events",
  itemListElement: references.map((reference, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Thing",
      name: reference.name,
      description: `${reference.period} — ${reference.participants}. ${reference.detail}`,
      subjectOf: site.url + "/references/",
    },
  })),
};
---

<BaseLayout title={title} description={description} path="/references/" jsonLd={itemListLd}>
  <Breadcrumbs items={[{ label: "Références" }]} />
  <PageHero
    eyebrow="Références clients"
    title="Des missions réelles, documentées depuis 2006"
    subtitle="Euro Events accompagne des entreprises de toutes tailles pour leurs séminaires, conventions, réunions, hébergements, soirées et prestations événementielles. Les exemples ci-dessous correspondent à des dossiers réellement traités par l'agence."
    cta
  />

  <LogoCloud title="Quelques-unes des entreprises accompagnées" />

  <section class="section bg-ivory">
    <div class="container">
      <div class="section-head text-center reveal">
        <p class="eyebrow">Expérience vérifiable</p>
        <h2>Quelques collaborations dans la durée</h2>
        <p class="lead">
          Des petits comités aux événements de plusieurs centaines de participants, en France comme à l'étranger.
        </p>
      </div>
      <div class="reference-grid">
        {
          references.map((reference) => (
            <article class="reference-card reveal">
              <div class="reference-topline">
                <span class="reference-period">{reference.period}</span>
                <span class="reference-size">{reference.participants}</span>
              </div>
              <h3>{reference.name}</h3>
              <p>{reference.detail}</p>
            </article>
          ))
        }
      </div>
      <p class="reference-note reveal">
        Cette sélection n'est pas exhaustive. D'autres références et missions sont présentées sur la page d'accueil et peuvent être précisées selon votre secteur ou votre type d'événement.
      </p>
    </div>
  </section>

  <Testimonials />

  <CTASection title="Parlons de votre prochain événement" />
</BaseLayout>

<style>
  .reference-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .reference-card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }
  .reference-topline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.7rem;
  }
  .reference-period,
  .reference-size {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--color-accent-dark);
  }
  .reference-card h3 {
    margin-bottom: 0.6rem;
  }
  .reference-card p {
    margin: 0;
    color: var(--color-ink-soft);
  }
  .reference-note {
    max-width: 72ch;
    margin: 2rem auto 0;
    text-align: center;
    color: var(--color-muted);
  }
  @media (max-width: 900px) {
    .reference-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 620px) {
    .reference-grid { grid-template-columns: 1fr; }
  }
</style>