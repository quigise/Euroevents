---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Gallery from "../components/Gallery.astro";
import CTASection from "../components/CTASection.astro";

const title = "Galerie photos | Lieux & événements — Euro Events";
const description =
  "Parcourez notre galerie : lieux d'exception, séminaires, conventions et soirées d'entreprise organisés grâce à Euro Events. Trouvons ensemble le cadre idéal pour votre événement.";

const categories = [
  { key: "lieux", label: "Lieux" },
  { key: "seminaires", label: "Séminaires & conventions" },
  { key: "soirees", label: "Soirées & gala" },
  { key: "teambuilding", label: "Team building" },
];

const images = [
  { src: "/images/hero/1.jpg", alt: "Château de Chambord, lieu d'exception", caption: "Château de Chambord · Val de Loire", category: "lieux" },
  { src: "/images/events/convention.jpg", alt: "Auditorium contemporain à boiseries chaudes", caption: "Auditorium & plénière", category: "seminaires" },
  { src: "/images/events/teambuilding.jpg", alt: "Banquet de groupe en cave voûtée en pierre", caption: "Team building en cave voûtée", category: "teambuilding" },
  { src: "/images/gallery/sommet.jpg", alt: "Plénière de convention, scène éclairée en bleu", caption: "Convention plénière", category: "seminaires" },
  { src: "/images/events/reunion.jpg", alt: "Salle de réunion parisienne moderne et colorée", caption: "Journée d'étude · Paris", category: "seminaires" },
  { src: "/images/hero/3.jpg", alt: "Atrium majestueux d'un palace parisien", caption: "Palace parisien · Atrium", category: "lieux" },
  { src: "/images/hero/4.jpg", alt: "Rooftop avec piscine au crépuscule face à la baie", caption: "Rooftop sur la baie · Soirée", category: "lieux" },
  { src: "/images/gallery/table-gala.jpg", alt: "Table de gala dressée, couverts dorés et centre floral", caption: "Table de gala", category: "soirees" },
  { src: "/images/gallery/chateau-etang.jpg", alt: "Château au bord de l'étang, terrasse aux parasols blancs", caption: "Château au bord de l'eau", category: "lieux" },
  { src: "/images/gallery/molitor.jpg", alt: "Rooftop du Molitor à Paris, piscine et tables colorées", caption: "Molitor · Paris", category: "lieux" },
  { src: "/images/gallery/lounge-domaine.jpg", alt: "Espace lounge lumineux d'un domaine de séminaire", caption: "Domaine de la Voisine · Lounge", category: "lieux" },
  { src: "/images/gallery/amphitheatre.jpg", alt: "Amphithéâtre de séminaire sous charpente en briques", caption: "Amphithéâtre · Milan", category: "seminaires" },
  { src: "/images/gallery/salon-reunion.jpg", alt: "Salon de réunion avec longue table dressée", caption: "Salon de réunion", category: "seminaires" },
  { src: "/images/gallery/diner-chateau.jpg", alt: "Dîner de gala sous lustre au Château de Fère", caption: "Château de Fère · Dîner", category: "soirees" },
  { src: "/images/gallery/rafting.jpg", alt: "Équipes en rafting lors d'un team building sur la rivière", caption: "Team building · Rafting", category: "teambuilding" },
];
---

<BaseLayout title={title} description={description} path="/galerie/">
  <Breadcrumbs items={[{ label: "Galerie" }]} />
  <PageHero
    eyebrow="Galerie photos"
    title="Des lieux et des moments d'exception"
    subtitle="Un aperçu des lieux et événements que nous trouvons et coordonnons pour les entreprises. Cliquez sur une image pour l'agrandir."
    cta
  />

  <section class="section bg-white">
    <div class="container">
      <Gallery images={images} categories={categories} />
    </div>
  </section>

  <CTASection title="Un lieu vous fait envie ? Parlons-en." />
</BaseLayout>

<style>
  .gallery-note {
    text-align: center;
    color: var(--color-muted);
    margin-bottom: 2rem;
    background: var(--color-cream);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.8rem 1.2rem;
  }
</style>
