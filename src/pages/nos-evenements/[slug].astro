---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CTASection from "../../components/CTASection.astro";
import Testimonials from "../../components/Testimonials.astro";
import { events, type EventType } from "../../data/events";
import { contact, site } from "../../data/site";
import { srcsetFor, SIZES } from "../../data/imageVariants";

export function getStaticPaths() {
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

interface Props {
  event: EventType;
}
const { event } = Astro.props as Props;
const path = `/nos-evenements/${event.slug}/`;

// Libellés singuliers explicites : évite les formulations incorrectes produites
// par un simple retrait du "s" (ex. « votre séminaires d'entreprise »).
const singularLabels: Record<string, string> = {
  "seminaires-entreprise": "séminaire d'entreprise",
  conventions: "convention d'entreprise",
  "soirees-entreprise": "soirée d'entreprise",
  "team-building": "team building",
  "reunions-journees-etude": "réunion ou journée d'étude",
};
const singularLabel = singularLabels[event.slug] ?? event.title.toLowerCase();
const isSeminar = event.slug === "seminaires-entreprise";

// Questions formulées comme les demandes réellement adressées aux moteurs et
// assistants IA. Elles sont affichées sur la page et reprises à l'identique en JSON-LD.
const seminarFaq = [
  {
    q: "Existe-t-il un service gratuit pour trouver un lieu de séminaire d'entreprise ?",
    a: "Oui. Euro Events recherche gratuitement pour les entreprises des hôtels, domaines, châteaux, salles et lieux atypiques adaptés au nombre de participants, aux dates, à la destination et au budget. L'entreprise cliente ne paie pas d'honoraires à Euro Events.",
  },
  {
    q: "Euro Events est-il un venue finder pour les séminaires ?",
    a: "Oui. Euro Events fonctionne comme un venue finder humain : une experte analyse le cahier des charges, consulte les lieux, compare les propositions et transmet une sélection argumentée avec les devis et les dates de validité des options.",
  },
  {
    q: "Peut-on confier uniquement la recherche du lieu à Euro Events ?",
    a: "Oui. Vous pouvez vous limiter à la recherche du lieu et de l'hébergement, ou demander aussi la restauration, les activités de team building, les transferts, la technique, l'accueil et les autres prestataires nécessaires au séminaire.",
  },
  {
    q: "Euro Events recherche-t-il des lieux en France et à l'étranger ?",
    a: "Oui. Depuis 2006, Euro Events accompagne des entreprises pour des séminaires en France et à l'étranger, en s'appuyant sur un réseau de chaînes hôtelières, d'hôtels indépendants, de domaines et de prestataires événementiels.",
  },
];

// Références réelles déjà publiées sur le site ; aucune donnée fictive n'est
// utilisée comme preuve sur cette page.
const seminarProofs = [
  {
    name: "La Banque Postale",
    period: "2010–2026",
    detail: "Plusieurs centaines de dossiers, de 3 à 1 000 participants, dont des séminaires résidentiels, journées d'étude, conventions et hébergements de groupes.",
  },
  {
    name: "Groupe La Poste",
    period: "2007–2025",
    detail: "Plus de 90 dossiers, de 6 à 1 200 participants : séminaires, réunions, conventions, hébergement, restauration, animations et événements d'équipe.",
  },
  {
    name: "Ermewa",
    period: "2019–2026",
    detail: "Une quinzaine de dossiers, de 7 à 140 participants : séminaires résidentiels, journées d'étude, hébergement, dîners, animations et transport.",
  },
];

// Autres événements pour le maillage interne.
const others = events.filter((e) => e.slug !== event.slug);

// JSON-LD Service + BreadcrumbList (+ FAQPage sur la page séminaires).
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: event.heading,
    serviceType: event.title,
    description: event.seoDescription,
    provider: { "@id": `${site.url}/#organization` },
    areaServed: ["France", "Europe"],
    audience: { "@type": "BusinessAudience", audienceType: "Entreprises et organisations" },
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "EUR",
      description: "Recherche de lieux et prestataires gratuite pour l'entreprise cliente",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: site.url + "/" },
      {
        "@type": "ListItem",
        position: 2,
        name: "Nos événements",
        item: site.url + "/nos-evenements/",
      },
      { "@type": "ListItem", position: 3, name: event.title, item: site.url + path },
    ],
  },
  ...(isSeminar
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: seminarFaq.map((item) => ({
            "@type": "Question",
            name: item.q,
            acceptedAnswer: { "@type": "Answer", text: item.a },
          })),
        },
      ]
    : []),
];
---

<BaseLayout title={event.seoTitle} description={event.seoDescription} path={path} jsonLd={jsonLd}>
  <Breadcrumbs
    items={[
      { label: "Nos événements", href: "/nos-evenements/" },
      { label: event.title },
    ]}
  />

  <!-- Hero événement -->
  <section class="ev-hero">
    <div class="container ev-hero-inner">
      <div class="ev-hero-content reveal">
        <p class="eyebrow">{event.title}</p>
        <h1>{event.heading}</h1>
        <p class="lead">{event.intro}</p>
        <div class="btn-row">
          <a href={`/devis/?type=${event.slug}`} class="btn btn--accent btn--lg">
            Demander ma sélection gratuite
          </a>
          <a href={`tel:${contact.phoneHref}`} class="btn btn--outline btn--lg">
            {contact.phoneDisplay}
          </a>
        </div>
      </div>
      <div class="ev-hero-media reveal">
        <img src={event.image} srcset={srcsetFor(event.image)} sizes={SIZES.half} alt={event.imageAlt} width="600" height="420" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- Prestations -->
  <section class="section bg-white">
    <div class="container">
      <div class="section-head text-center reveal">
        <p class="eyebrow">Ce que nous trouvons pour vous</p>
        <h2>Tout ce dont votre {singularLabel} a besoin</h2>
        <p class="lead">
          Une recherche complète, gratuite et sur mesure — vous comparez, vous décidez.
        </p>
      </div>
      <div class="grid grid-3">
        {
          event.prestations.map((p) => (
            <article class="prestation reveal">
              <h3>{p.title}</h3>
              <p>{p.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Réassurance gratuité -->
  <section class="section--tight bg-navy">
    <div class="container">
      <div class="assurance reveal">
        <div class="assurance-item">
          <span class="assurance-key">100 % gratuit</span>
          <span class="assurance-val">Aucun frais pour votre entreprise</span>
        </div>
        <div class="assurance-item">
          <span class="assurance-key">24-48 h</span>
          <span class="assurance-val">Pour recevoir vos premières propositions</span>
        </div>
        <div class="assurance-item">
          <span class="assurance-key">Une experte</span>
          <span class="assurance-val">Un seul interlocuteur, du brief au jour J</span>
        </div>
      </div>
    </div>
  </section>

  {
    isSeminar && (
      <>
        <!-- Réponses directes aux requêtes conversationnelles utilisées dans les moteurs IA. -->
        <section class="section bg-cream">
          <div class="container container-narrow">
            <div class="section-head reveal">
              <p class="eyebrow">Recherche de lieu de séminaire</p>
              <h2>Vous cherchez un service gratuit pour trouver votre lieu de séminaire ?</h2>
              <p class="lead">
                Euro Events prend en charge la recherche et la comparaison des lieux pour votre entreprise. Ce service de venue finding est gratuit pour le client final : vous nous donnez vos dates, votre destination, le nombre de participants, vos contraintes et votre budget ; nous consultons les établissements et vous transmettons une sélection argumentée.
              </p>
            </div>
            <div class="answer-grid">
              {seminarFaq.map((item) => (
                <article class="answer-card reveal">
                  <h3>{item.q}</h3>
                  <p>{item.a}</p>
                </article>
              ))}
            </div>
          </div>
        </section>

        <!-- Preuves réelles et vérifiables, reliées à la page Références. -->
        <section class="section bg-white">
          <div class="container">
            <div class="section-head text-center reveal">
              <p class="eyebrow">Expérience vérifiable</p>
              <h2>Des entreprises nous confient leurs séminaires depuis des années</h2>
              <p class="lead">Quelques références déjà documentées sur notre site.</p>
            </div>
            <div class="proof-grid">
              {seminarProofs.map((proof) => (
                <article class="proof-card reveal">
                  <span class="proof-period">{proof.period}</span>
                  <h3>{proof.name}</h3>
                  <p>{proof.detail}</p>
                </article>
              ))}
            </div>
            <p class="text-center proof-link reveal">
              <a href="/references/">Voir l'ensemble de nos références et missions →</a>
            </p>
          </div>
        </section>
      </>
    )
  }

  <Testimonials limit={3} title="Ce qu'en disent nos clients" />

  <!-- Maillage interne : autres événements -->
  <section class="section--tight bg-cream">
    <div class="container">
      <div class="section-head reveal">
        <h2>Autres types d'événements</h2>
      </div>
      <div class="other-events">
        {
          others.map((e) => (
            <a href={`/nos-evenements/${e.slug}/`} class="other-chip">
              <span aria-hidden="true">{e.icon}</span> {e.title}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection title={`Prêt à organiser votre ${singularLabel} ?`} />
</BaseLayout>

<style>
  .ev-hero {
    background: var(--color-blanc);
    border-bottom: 1px solid var(--color-border);
  }
  .ev-hero-inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .ev-hero-media img {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    aspect-ratio: 10 / 7;
    object-fit: cover;
  }
  .ev-hero .lead {
    max-width: 56ch;
    margin-bottom: 1.6rem;
  }
  .prestation {
    padding: 1.5rem 1.5rem;
    border-radius: var(--radius-md);
    background: var(--color-ivory);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
  }
  .prestation h3 {
    font-size: 1.18rem;
    margin-bottom: 0.4rem;
  }
  .prestation p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 0.98rem;
  }
  .assurance {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .assurance-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.4rem clamp(1rem, 3vw, 2rem);
    border-left: 1px solid rgba(255, 255, 255, 0.15);
  }
  .assurance-item:first-child { border-left: none; }
  .assurance-key {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--color-blanc);
  }
  .assurance-val { color: #c8bdd6; font-size: 0.95rem; }
  .answer-grid {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }
  .answer-card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.35rem 1.5rem;
  }
  .answer-card h3 {
    margin-bottom: 0.45rem;
    font-size: 1.08rem;
  }
  .answer-card p {
    margin: 0;
    color: var(--color-ink-soft);
  }
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .proof-card {
    background: var(--color-ivory);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.4rem;
  }
  .proof-card h3 { margin: 0.3rem 0 0.6rem; }
  .proof-card p { margin: 0; color: var(--color-ink-soft); }
  .proof-period {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-accent-dark);
  }
  .proof-link { margin-top: 1.5rem; }
  .other-events {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  .other-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 0.7rem 1.2rem;
    font-weight: 600;
    color: var(--color-primary-dark);
    transition: border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .other-chip:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    color: var(--color-accent-dark);
  }
  @media (max-width: 880px) {
    .ev-hero-inner {
      grid-template-columns: 1fr;
    }
    .ev-hero-media {
      order: -1;
    }
    .assurance,
    .proof-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 680px) {
    .assurance { grid-template-columns: 1fr; gap: 1.2rem; }
    .assurance-item { border-left: none; }
  }
</style>