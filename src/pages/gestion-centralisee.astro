---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CTASection from "../components/CTASection.astro";
import { srcsetFor, SIZES } from "../data/imageVariants";

const title = "Gestion centralisée et facture unique | Euro Events";
const description =
  "Euro Events devient votre fournisseur événementiel unique : sourcing, négociation, coordination des prestataires, gestion administrative et facture centralisée.";

const benefits = [
  {
    n: "01",
    title: "Un fournisseur référencé",
    text: "Une fois Euro Events référencée par votre entreprise, vous accédez à notre réseau sans créer un nouveau fournisseur pour chaque lieu ou prestation.",
  },
  {
    n: "02",
    title: "Une gestion simplifiée",
    text: "Nous centralisons les échanges contractuels, les commandes et le suivi administratif des prestataires retenus pour votre événement.",
  },
  {
    n: "03",
    title: "Une facture unique",
    text: "Hébergement, restauration, salles, transferts, animations et prestations techniques peuvent être regroupés sur une seule facture Euro Events.",
  },
  {
    n: "04",
    title: "Un budget négocié",
    text: "Chaque proposition est comparée et négociée afin d'optimiser votre enveloppe et de vous faire bénéficier des conditions de notre réseau.",
  },
];

const steps = [
  ["Vous partagez votre procédure achats", "Nous identifions vos contraintes de référencement, de commande, de règlement et de reporting."],
  ["Nous construisons votre sélection", "Une experte recherche les solutions adaptées, compare les devis et négocie les conditions."],
  ["Vous validez les prestations", "Vous conservez la décision finale sur chaque lieu et chaque prestataire proposé."],
  ["Euro Events centralise", "Nous coordonnons les éléments contractuels et financiers, puis votre entreprise reçoit une facture unique."],
];
---

<BaseLayout title={title} description={description} path="/gestion-centralisee/">
  <Breadcrumbs items={[{ label: "Gestion centralisée" }]} />

  <section class="integrated-hero">
    <div class="integrated-hero__media">
      <img
        src="/images/gallery/salon-reunion.jpg"
        srcset={srcsetFor("/images/gallery/salon-reunion.jpg")}
        sizes={SIZES.full}
        alt="Salle préparée pour un séminaire d'entreprise"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="integrated-hero__scrim"></div>
    <div class="container integrated-hero__content">
      <p class="eyebrow">Solution intégrée</p>
      <h1>Un seul partenaire.<br />Une seule facture.<br /><em>Une gestion simplifiée.</em></h1>
      <p>
        Euro Events devient votre interlocuteur contractuel unique, coordonne les prestataires
        de votre événement et centralise l'ensemble de la facturation.
      </p>
      <div class="btn-row">
        <a href="/contact/" class="btn btn--accent btn--lg">Parler de votre procédure achats</a>
        <a href="#fonctionnement" class="btn btn--ghostlight btn--lg">Découvrir la solution</a>
      </div>
    </div>
  </section>

  <section class="section intro-section">
    <div class="container intro-grid">
      <div>
        <p class="eyebrow">Pour les entreprises aux achats centralisés</p>
        <h2>Votre réseau de prestataires, sans multiplier les référencements.</h2>
      </div>
      <div class="intro-copy">
        <p class="lead">
          Certaines entreprises souhaitent limiter le nombre de fournisseurs référencés.
          Euro Events leur apporte une réponse simple : l'agence est référencée une fois,
          puis prend en charge la gestion administrative et financière des prestations retenues.
        </p>
        <p>
          Vous conservez la richesse d'une sélection sur mesure et la liberté de choisir,
          tout en allégeant le travail de vos équipes achats, comptables et événementielles.
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Les bénéfices</p>
        <h2>Moins d'administratif. Plus de visibilité.</h2>
      </div>
      <div class="benefit-grid">
        {benefits.map((benefit) => (
          <article class="benefit-card reveal">
            <span>{benefit.n}</span>
            <h3>{benefit.title}</h3>
            <p>{benefit.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section process-section" id="fonctionnement">
    <div class="container process-grid">
      <div class="process-media reveal">
        <img
          src="/images/gallery/table-gala.jpg"
          srcset={srcsetFor("/images/gallery/table-gala.jpg")}
          sizes={SIZES.half}
          alt="Table de réception préparée pour un événement d'entreprise"
          loading="lazy"
        />
      </div>
      <div>
        <p class="eyebrow">Comment ça fonctionne</p>
        <h2>Une procédure claire, adaptée à votre organisation.</h2>
        <ol class="process-list">
          {steps.map((step, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div><h3>{step[0]}</h3><p>{step[1]}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section bg-navy pricing-section">
    <div class="container pricing-grid">
      <div>
        <p class="eyebrow">Une prestation transparente</p>
        <h2>Des honoraires clairement définis.</h2>
      </div>
      <div>
        <p class="lead">
          La solution intégrée comprend la gestion contractuelle, administrative et financière
          des prestataires. Elle fait l'objet d'honoraires de gestion indiqués dans notre
          proposition commerciale, en toute transparence.
        </p>
        <p>
          La coordination et la présence sur place peuvent également être assurées selon les
          besoins de votre événement. Chaque mission est cadrée avant votre validation.
        </p>
        <a href="/contact/" class="btn btn--outline btn--lg">Étudier votre besoin</a>
      </div>
    </div>
  </section>

  <CTASection
    title="Simplifions la gestion de vos événements"
    text="Présentez-nous votre procédure achats et vos contraintes de référencement. Nous vous proposerons un fonctionnement adapté à votre entreprise."
  />
</BaseLayout>

<style>
  .integrated-hero { position: relative; min-height: 72svh; display: flex; align-items: flex-end; color: #fff; overflow: hidden; }
  .integrated-hero__media, .integrated-hero__scrim { position: absolute; inset: 0; }
  .integrated-hero__media img { width: 100%; height: 100%; object-fit: cover; }
  .integrated-hero__scrim { background: linear-gradient(90deg, rgba(22,17,31,.92) 0%, rgba(22,17,31,.7) 48%, rgba(22,17,31,.2) 100%); }
  .integrated-hero__content { position: relative; z-index: 1; padding-block: clamp(5rem, 11vw, 8rem) clamp(4rem, 8vw, 6rem); }
  .integrated-hero h1 { max-width: 13ch; color: #fff; font-size: clamp(2.8rem, 6vw, 5.4rem); line-height: .98; margin-bottom: 1.4rem; }
  .integrated-hero h1 em { color: var(--color-laiton-clair); font-family: var(--font-italic); font-weight: 400; }
  .integrated-hero__content > p:not(.eyebrow) { max-width: 58ch; font-size: clamp(1.1rem, 2vw, 1.3rem); color: rgba(255,255,255,.86); }
  .intro-grid, .pricing-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .intro-copy p:last-child { margin-bottom: 0; }
  .benefit-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); }
  .benefit-card { background: var(--color-white); padding: clamp(1.6rem, 4vw, 2.6rem); }
  .benefit-card > span { font-family: var(--font-mono); color: var(--color-laiton-fonce); font-size: .78rem; letter-spacing: .12em; }
  .benefit-card h3 { margin: 1.3rem 0 .5rem; }
  .benefit-card p { margin: 0; color: var(--color-ink-soft); }
  .process-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(2.5rem, 7vw, 6rem); align-items: center; }
  .process-media img { width: 100%; min-height: 620px; object-fit: cover; }
  .process-list { list-style: none; margin: 2rem 0 0; padding: 0; }
  .process-list li { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1.25rem 0; border-top: 1px solid var(--color-border); }
  .process-list li > span { font-family: var(--font-mono); color: var(--color-laiton-fonce); font-size: .76rem; }
  .process-list h3 { font-size: 1.12rem; margin-bottom: .25rem; }
  .process-list p { margin: 0; color: var(--color-ink-soft); }
  .pricing-section .lead { color: #fff; }
  .pricing-section p:not(.eyebrow) { color: #c2c6d0; }
  .pricing-section .btn { margin-top: 1rem; }
  @media (max-width: 820px) {
    .intro-grid, .pricing-grid, .process-grid { grid-template-columns: 1fr; }
    .benefit-grid { grid-template-columns: 1fr; }
    .process-media img { min-height: 360px; }
    .integrated-hero__scrim { background: linear-gradient(0deg, rgba(22,17,31,.94), rgba(22,17,31,.42)); }
  }
</style>
